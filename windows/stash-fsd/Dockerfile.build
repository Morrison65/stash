# Toolchain image used by scripts/dev/fsd-build.sh to test stash-fsd on Linux
# and cross-compile stash-fsd.exe for x86_64-pc-windows-gnu. Nothing is
# installed on the host.
FROM rust:1-bookworm

RUN apt-get update \
	&& apt-get install -y --no-install-recommends mingw-w64 \
	&& rm -rf /var/lib/apt/lists/* \
	&& rustup target add x86_64-pc-windows-gnu

ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc
WORKDIR /src/windows/stash-fsd
