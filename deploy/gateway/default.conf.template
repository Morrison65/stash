# Stash gateway. Rendered by the nginx image's envsubst at start-up; only the
# variables defined in the environment (API_UPSTREAM, FSD_HTTP_UPSTREAM,
# MAX_UPLOAD_SIZE) are substituted, nginx's own $variables are untouched.

# Access log with request and upstream times (seconds), to find slow requests.
log_format stash_timed '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                       'rt=$request_time urt=$upstream_response_time "$http_referer"';

upstream stash_api {
    server ${API_UPSTREAM};
    keepalive 32;
}

upstream stash_fsd {
    server ${FSD_HTTP_UPSTREAM};
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/access.log stash_timed;

    client_max_body_size ${MAX_UPLOAD_SIZE};
    root /usr/share/stash-ui;

    # Headers as in Stash's reverse proxy guide
    # (https://docs.stashapp.cc/guides/reverse-proxy/). Stash builds its base
    # URL from Host (incl. the port), X-Forwarded-Proto and, when served under
    # a prefix, X-Forwarded-Prefix (not used: the gateway serves the root).
    # X-Forwarded-Port is not read by Stash and would be the container's 80.
    proxy_http_version 1.1;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # Hashed build assets: served from disk, cached forever. The UI build
    # only ships pre-compressed .gz for js/css/json/svg/md.
    location /assets/ {
        gzip_static always;
        gunzip on;
        add_header Cache-Control "public, max-age=31536000, immutable";
        # index.html comes from the API (auth, base href, theme). If the API
        # image was built from a different UI build than this gateway, the
        # hashed asset names differ: fall back to the API's embedded copy.
        try_files $uri @api;
    }

    location @api {
        proxy_pass http://stash_api;
    }

    # sw.js removes the former UI config service worker from browsers that
    # still have it; it must always be revalidated.
    location = /sw.js {
        gzip_static always;
        gunzip on;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # GraphQL incl. graphql-ws subscriptions. Long timeouts as in the guide
    # (slow operations such as database migrations, idle subscriptions).
    location /graphql {
        proxy_pass http://stash_api;
        proxy_read_timeout 60000s;
        proxy_send_timeout 60000s;
    }

    # Raw library files streamed straight from stash-fsd on Windows. Only
    # reachable through X-Accel-Redirect issued by the API after it has
    # authorised the request; the URL carries an HMAC signature.
    location /_fsd/ {
        internal;
        proxy_pass http://stash_fsd/;
        proxy_set_header Host       $proxy_host;
        proxy_set_header Connection "";
        proxy_set_header Range      $http_range;
        proxy_set_header If-Range   $http_if_range;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Generated files (previews, sprites, screenshots, VTTs) from the shared
    # volume, after the API has authorised the request (X-Accel-Redirect).
    location /_generated/ {
        internal;
        alias /generated/;
        sendfile on;
        tcp_nopush on;
    }

    # Everything else (index.html with auth redirects, login, media routes,
    # plugin assets, custom css/js) is handled by the API.
    location / {
        proxy_pass http://stash_api;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 60000s;
        proxy_send_timeout 60000s;
    }
}
