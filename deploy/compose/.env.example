# Copy to .env and adjust.

# Port of the gateway on the Docker host (the UI and API are served here).
STASH_GATEWAY_PORT=9990

# stash-fsd on the Windows host. host.docker.internal works with Docker
# Desktop; use the host's LAN IP otherwise.
STASH_FSD_GRPC=host.docker.internal:7700
STASH_FSD_HTTP=host.docker.internal:7701

# Must equal [server] shared_secret in stash-fsd.toml. Generate with e.g.
#   openssl rand -hex 32
STASH_FSD_SECRET=

# SQLite page cache per connection, negative = KiB (-262144 = 256 MiB).
STASH_SQLITE_CACHE_SIZE=-262144

STASH_MAX_UPLOAD_SIZE=1g
TZ=Europe/Berlin
